{
  "name": "satin-road-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun build.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "generate-api": "swagger-typescript-api generate -p http://localhost:5120/swagger/v1/swagger.json -o ./src/generated -n api.ts --unwrap-response-data"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "bun-plugin-tailwind": "^0.1.2",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "swagger-typescript-api": "^13.13.0"
  }
}
